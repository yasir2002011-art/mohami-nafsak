# كلمة مرور لوحة الإدارة — في الإنتاج يجب أن تكون 12 حرفًا فأكثر وقوية
ADMIN_PASSWORD=change-me-now

# مفتاح توقيع جلسة الإدارة — في الإنتاج يجب أن يكون 32 حرفًا عشوائيًا فأكثر
# لتوليده: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=please-generate-a-long-random-string
# ملاحظة: إن لم يُضبط المفتاحان بقوة كافية في الإنتاج تُقفل لوحة الإدارة تلقائيًا (فشل مغلق).

# قاعدة البيانات السحابية (Postgres مثل Neon).
# عند ضبطها تُحفَظ بيانات المحتوى (المحامون، المقالات، الإعلانات، الإحالات،
# الإحصاءات، الإعدادات…) في القاعدة، فتبقى محفوظة وتُدار من أي جهاز.
# بدونها يعمل الموقع على الملفات كما هو (لكن التعديلات لا تُحفظ على Vercel).
# أنشئ قاعدة مجانية من neon.com وانسخ رابط الاتصال (يبدأ بـ postgres://).
# DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# عنوان الموقع — يُترك فارغًا على Vercel فيُلتقط تلقائيًا
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# وضع العرض: يمنع الكتابة في ملفات data ويُظهر بيانًا في لوحة الإدارة.
# يُفعَّل تلقائيًا على Vercel، ويمكن فرضه محليًا للتجربة بوضع القيمة 1
# READ_ONLY_DATA=1

# مفتاح Gemini لتحليل أسباب الاعتراض على نتيجة الحضانة.
# خادمي فقط — لا يبدأ بـ NEXT_PUBLIC حتى لا يُكشف للمتصفح.
# بدونه يعمل الموقع كاملًا، ويظهر تنبيه للمطوّر عند طلب التحليل فقط.
GEMINI_API_KEY=
# اختياري: النموذج والنموذج الاحتياطي
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite

# مفتاح إيقاف صلب لتحليل الذكاء الاصطناعي — ضع 1 لإيقافه فورًا عند أي إساءة
# AI_ANALYSIS_DISABLED=0

# تحديد معدّل الطلبات عبر Upstash Redis (يُنصح به بشدّة للإنتاج).
# بدونه يعمل التحديد في الذاكرة كحماية جزئية فقط. أنشئ قاعدة مجانية من upstash.com
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
