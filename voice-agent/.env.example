# خدمة الصوت «المحامي الاصطناعي» — انسخ الملف إلى .env.local واملأه. لا ترفعه إلى المستودع.

# مفتاح التشغيل: بدون 1 يرفض الوكيل أي مكالمة
EXPERIMENT_VOICE=1

# LiveKit Cloud (من لوحة المشروع: Settings → API Keys)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=mohami-agent

# Gemini Live (نفس مفتاح Gemini، ويفضَّل بعد تفعيل الفوترة)
GOOGLE_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_LIVE_VOICE=Sadaltager

# عنوان الموقع الذي فيه مسار الإجابة، والسر المشترك معه (نفس قيمة EXPERIMENT_AGENT_SECRET في الموقع)
SITE_URL=http://localhost:3001
EXPERIMENT_AGENT_SECRET=

# خط الاتصال الصادر (لـ«اتصلوا بي» فقط) — معرّف الخط من LiveKit بعد ربط Twilio
LIVEKIT_SIP_TRUNK_ID=

# أقصى مدة للمكالمة بالثواني
MAX_CALL_SECONDS=900
